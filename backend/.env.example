# Copy this file to .env and fill in real values.
# NEVER put real secrets in this file — it is meant to be committed.

# Gemini on Google Vertex AI.
# Auth: point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON key,
# or leave it empty and run `gcloud auth application-default login`.
# The project needs the Vertex AI API enabled: gcloud services enable aiplatform.googleapis.com
VERTEX_PROJECT_ID=
VERTEX_LOCATION=asia-southeast1
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=

# Create a bot via https://t.me/BotFather (takes ~2 minutes), copy the token here.
TELEGRAM_BOT_TOKEN=

# The shop owner's Telegram chat id — where approval cards and auto-reply
# digests are pushed. To find it: start the server, send any message to your
# bot from the owner account, then open http://localhost:8000/api/telegram/recent-chats
OWNER_TELEGRAM_CHAT_ID=
NOTIFY_AUTO_REPLIES=true

# Facebook Messenger — https://developers.facebook.com → your app → Messenger.
# Needs a public HTTPS webhook, e.g. `cloudflared tunnel --url http://localhost:8000`,
# then set the callback URL to <public-url>/webhooks/messenger with the verify token below.
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=banno-verify
MESSENGER_APP_SECRET=

# Leave true for the hackathon demo (uses backend/data/*.json shaped like
# Shopify's Admin API). Set to false + fill the two vars below once you have
# a real Shopify dev store to plug in with no code changes.
USE_MOCK_COMMERCE=true
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

ENABLE_UPSELL=true
SHOP_NAME=Banno Eyewear
